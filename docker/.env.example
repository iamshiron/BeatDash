# Docker Environment Overrides
# Copy to .env in the docker directory or set in parent .env

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=beatdash
POSTGRES_PORT=5432

# RustFS (legacy MINIO_* settings are also accepted)
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=admin_pw
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# RustFS Buckets - BeatDash
RUSTFS_BUCKET_ASSETS=beatdash-assets
RUSTFS_BUCKET_USER_DATA=beatdash-user-data
