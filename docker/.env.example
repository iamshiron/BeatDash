# Docker Environment Overrides
# Copy to .env in the docker directory or set in parent .env

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=admin
POSTGRES_PORT=5432

# MinIO
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Buckets - MUtils
MUTILS_MINIO_BUCKET_ASSETS=mutils-assets
MUTILS_MINIO_BUCKET_USER_DATA=mutils-user-data

# MinIO Buckets - Archive
ARCHIVE_MINIO_BUCKET_ASSETS=mutils-assets
ARCHIVE_MINIO_BUCKET_USER_DATA=archive-user-data

# MinIO Buckets - HonamiGit
HONAMI_GIT_BUCKET_ASSETS=honami-git-assets
HONAMI_GIT_BUCKET_USER_DATA=honami-git-user-data
HONAMI_GIT_BUCKET_LFS=honami-git-lfs
