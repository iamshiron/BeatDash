# Docker Environment Overrides
# Copy to .env in the docker directory or set in parent .env

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=beatdash
POSTGRES_PORT=5432

# MinIO
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Buckets - BeatDash
MINIO_BUCKET_ASSETS=beatdash-assets
MINIO_BUCKET_USER_DATA=beatdash-user-data
