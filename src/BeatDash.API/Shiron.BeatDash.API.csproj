<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WebClientRoot>$(MSBuildProjectDirectory)/../../apps/beatdash-web</WebClientRoot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BlurHashSharp"/>
        <PackageReference Include="DotNetEnv"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.IdentityModel.Tokens"/>
        <PackageReference Include="Microsoft.OpenApi"/>
        <PackageReference Include="Minio"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design"/>
        <PackageReference Include="Quartz"/>
        <PackageReference Include="Quartz.Extensions.Hosting"/>
        <PackageReference Include="Scalar.AspNetCore"/>
        <PackageReference Include="SkiaSharp"/>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BeatDash.Analysis\Shiron.BeatDash.Analysis.csproj"/>
        <ProjectReference Include="..\BeatDash.Beatmaps\Shiron.BeatDash.Beatmaps.csproj"/>
        <ProjectReference Include="..\BeatDash.Data\Shiron.BeatDash.Data.csproj"/>
        <ProjectReference Include="..\BeatDash.DB\Shiron.BeatDash.DB.csproj"/>
    </ItemGroup>

    <Target Name="BuildWebClient" BeforeTargets="AssignTargetPaths"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipWebBuild)' != 'true'">
        <Exec WorkingDirectory="$(WebClientRoot)" Command="pnpm run build" />
    </Target>

    <Target Name="IncludeWebClient" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWebClient"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_WebClientFile Include="$(WebClientRoot)/dist/**/*" />
            <None Include="@(_WebClientFile)">
                <Link>wwwroot/%(_WebClientFile.RecursiveDir)%(_WebClientFile.Filename)%(_WebClientFile.Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </None>
        </ItemGroup>
    </Target>

</Project>
