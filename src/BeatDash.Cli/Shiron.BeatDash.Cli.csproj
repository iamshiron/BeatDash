<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Shiron.BeatDash.Cli</RootNamespace>
        <AssemblyName>beatdash</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux"/>
        <PackageReference Include="Spectre.Console"/>
        <PackageReference Include="Spectre.Console.Cli"/>
        <PackageReference Include="Spectre.Console.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BeatDash.Analysis\Shiron.BeatDash.Analysis.csproj"/>
        <ProjectReference Include="..\BeatDash.Beatmaps\Shiron.BeatDash.Beatmaps.csproj"/>
        <ProjectReference Include="..\BeatDash.Data\Shiron.BeatDash.Data.csproj"/>
    </ItemGroup>

</Project>
