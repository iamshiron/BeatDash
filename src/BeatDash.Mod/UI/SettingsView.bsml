<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>

    <settings-container>
        <string-setting id="host" text="Host"/>
        <string-setting id="pin" text="Pin"/>
        <bool-setting id="disableUdp" text="Disable UDP"/>
        <button id="submit-pin" on-click="OnSubmitPin" text="Submit"/>

        <text text="Developer Settings. Only adjust them if you know what you are doing."/>
        <slider-setting text="Transmit Buffer Size" id="transmitBufferSize" max="500" min="5" integer-only="true" increment="1"/>
        <bool-setting text="Disable Double Buffering" id="disableDoubleBuffering"/>
    </settings-container>
</bg>
