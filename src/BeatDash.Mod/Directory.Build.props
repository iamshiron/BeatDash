<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>
    <!-- Plugin Metadata -->
    <PropertyGroup>
        <PluginId>Shiron.BeatDash.Mod</PluginId>
        <PluginName>Shiron.BeatDash.Mod</PluginName>
        <AssemblyName>Shiron.BeatDash.Mod</AssemblyName>
        <Authors>Shiron</Authors>
        <Version>0.0.1</Version>
        <GameVersion>1.40.8</GameVersion>
        <Description>Companion/Peer mod for the BeatDash project</Description>
        <!--<PluginIcon></PluginIcon>-->
        <!--<ProjectSource></ProjectSource>-->
        <!--<ProjectHome></ProjectHome>-->
        <!--<DonateUrl></DonateUrl>-->
    </PropertyGroup>

    <!-- Plugin Dependencies -->
    <ItemGroup>
        <DependsOn Include="BSIPA" Version="^4.3.0"/>
    </ItemGroup>

    <PropertyGroup>
        <BSMTProjectType>BSIPA</BSMTProjectType>
        <GenerateManifest>true</GenerateManifest>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
        <DisableZipRelease>true</DisableZipRelease>
    </PropertyGroup>

    <Target Name="CopyToPluginsLinux" AfterTargets="Build" Condition="'$(OS)' == 'Unix'">
        <Message Text="[Linux] Copying mod to Beat Saber Plugins directory..." Importance="high"/>
        <MakeDir Directories="$(BeatSaberDir)/Plugins"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(BeatSaberDir)/Plugins"/>
    </Target>
</Project>
