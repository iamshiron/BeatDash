{
  // Copy this file to appsettings.json BESIDE Shiron.BeatDash.API.dll, then edit it.
  // .NET accepts these comments. Restart the server after configuration changes.
  // Environment variables override JSON: e.g. Registration__DisableSignup=true.
  // Bind to localhost by default. Use http://0.0.0.0:1811 for LAN access.
  // Put a TLS reverse proxy in front of the server before exposing it publicly.
  "Urls": "http://localhost:1811",
  "ConnectionStrings": {
    // PostgreSQL 17 connection string; create the database and database user first.
    "Default": "Host=localhost;Port=5432;Database=beatdash;Username=beatdash;Password=CHANGE_ME"
  },
  "Database": {
    // Apply bundled EF migrations before seeding the administrator. Back up before upgrades.
    // Enable on ONE instance only. The database user needs schema creation permissions.
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    // REQUIRED: replace with a random secret of at least 32 characters; never share it.
    "SecretKey": "CHANGE_ME_USE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "Issuer": "BeatDash",
    "Audience": "BeatDash"
  },
  "AdminUser": {
    // Creates the initial administrator if absent, even when public signup is disabled.
    // Use a strong password (upper/lowercase, digit, symbol). Editing it later does NOT reset an existing account.
    "Email": "admin@example.com",
    "Password": "CHANGE_ME_Strong_Admin_Password1!",
    "Role": "Admin"
  },
  "Registration": {
    // true: DO NOT MAP /api/auth/register. Direct POST requests return 404.
    // Login and the seeded administrator continue to work. Restart required.
    "DisableSignup": true
  },
  "Storage": {
    // RustFS S3 endpoint WITHOUT http:// or https://; this is NOT its console port.
    // Existing RUSTFS_* (or legacy MINIO_*) environment settings also work and override this section.
    "Endpoint": "localhost:9000",
    "AccessKey": "CHANGE_ME",
    "SecretKey": "CHANGE_ME",
    "UseSsl": false,
    // Create these buckets before starting; assets: public GetObject, user data: private.
    "BucketAssets": "beatdash-assets",
    "BucketUserData": "beatdash-user-data"
  },
  "UdpSocket": {
    // Open this UDP port for the game mod; the HTTP listener uses TCP.
    "Host": "0.0.0.0",
    "Port": 1811
  },
  "Hsp": {
    // Optional complete public ingest URL when running behind a proxy; blank uses LAN discovery.
    "PublicIngestUrl": ""
  },
  "Backup": {
    // Normally false. Maintenance mode disables normal use for admin backup/restore operations.
    "MaintenanceMode": false,
    // Private persistent directory OUTSIDE wwwroot; relative paths resolve against the working directory.
    "WorkDirectory": "./backup-work",
    "MaxArchiveBytes": 1099511627776
  },
  "BeatSaver": {
    "ApiBaseUrl": "https://api.beatsaver.com",
    "FetchOnStartup": true,
    "ScheduledFetchEnabled": true,
    "ScheduledFetchIntervalMinutes": 60,
    "FetchOnNewMap": true,
    "RequestsPerMinute": 60,
    "MaxFetchAttempts": 3,
    "MaxMapsPerRun": 0 // 0 = no per-run limit
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
