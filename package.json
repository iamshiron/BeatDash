{
    "name": "@shiron/monorepo",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "lint": "nx run-many --target=lint --all",
        "format": "nx run-many --target=format --all && dotnet format",
        "build": "nx run-many --target=build --all",
        "dev": "nx run-many --target=dev,run --all",
        "migrate": "nx run-many --target=migrate --all",
        "clean": "nx run-many --target=clean --all",
        "screenshots": "pnpm --filter @shiron/beatdash-screenshots screenshots"
    },
    "private": true,
    "devDependencies": {
        "@nx/dotnet": "24.0.0",
        "@nx/js": "24.0.0",
        "@nx/react": "24.0.0",
        "@nx/vite": "24.0.0",
        "@nx/web": "24.0.0",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.18",
        "@swc/helpers": "0.5.23",
        "@vitest/ui": "~5.0.5",
        "jiti": "2.7.0",
        "nx": "24.0.0",
        "prettier": "^3.9.10",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "~5.0.5"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}