ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=beatdash;Username=admin;Password=admin
AdminUser__Email=admin@beatdash.local
AdminUser__Password=admin
AdminUser__Role=Admin

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin_pw
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=beatdash-assets
MINIO_BUCKET_USER_DATA=beatdash-user-data

# UdpSockedt
UdpSocket__Host=0.0.0.0
UdpSocket__Port=1811

# BeatSaver fetch pipeline
BeatSaver__ApiBaseUrl=https://api.beatsaver.com
BeatSaver__FetchOnStartup=true
BeatSaver__ScheduledFetchEnabled=true
BeatSaver__ScheduledFetchIntervalMinutes=60
BeatSaver__FetchOnNewMap=true
BeatSaver__RequestsPerMinute=60
BeatSaver__MaxFetchAttempts=3
BeatSaver__MaxMapsPerRun=0

# Metric calibration (fitted by `beatdash beatmap calibrate`; weights stay in code, only scales/multiplier here)
Metrics__Difficulty__Scale=26.9119
Metrics__Pp__Multiplier=700
Metrics__Characteristics__stream__Scale=10.7698
Metrics__Characteristics__tech__Scale=3.1033
Metrics__Characteristics__speed__Scale=9.7839
Metrics__Characteristics__jumps__Scale=6.197
Metrics__Characteristics__gimmick__Scale=28.7331
