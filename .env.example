# Discord OAuth
MUTILS_DISCORD_CLIENT_ID=your_discord_client_id
MUTILS_DISCORD_CLIENT_SECRET=your_discord_client_secret
MUTILS_DISCORD_REDIRECT_URI=http://localhost:1910/auth/callback

# JWT
MUTILS_JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
MUTILS_JWT_EXPIRY_HOURS=24
MUTILS_JWT_ISSUER=mutils
MUTILS_JWT_AUDIENCE=mutils-users

# PostgreSQL
MUTILS_POSTGRES_HOST=localhost
MUTILS_POSTGRES_PORT=5432
MUTILS_POSTGRES_DB=mutils
MUTILS_POSTGRES_USER=mutils
MUTILS_POSTGRES_PASSWORD=mutils_dev_password

# Connection String (alternative)
MUTILS_ConnectionStrings__Default=Host=localhost;Port=5432;Database=mutils;Username=mutils;Password=mutils_dev_password

# MinIO
MUTILS_MINIO_ENDPOINT=localhost:9000
MUTILS_MINIO_ACCESS_KEY=minioadmin
MUTILS_MINIO_SECRET_KEY=minioadmin
MUTILS_MINIO_USE_SSL=false
MUTILS_MINIO_BUCKET_ASSETS=mutils-assets
MUTILS_MINIO_BUCKET_USER_DATA=mutils-user-data

# Backend
ASPNETCORE_ENVIRONMENT=Development

# Frontend (exposed to browser)
VITE_MUTILS_API_URL=http://localhost:1810/api
VITE_MUTILS_DISCORD_CLIENT_ID=your_discord_client_id
VITE_MUTILS_DISCORD_REDIRECT_URI=http://localhost:1910/auth/callback

# Beat Dash
BEATDASH_POSTGRES_USER=admin
BEATDASH_POSTGRES_PASSWORD=admin
BEATDASH_POSTGRES_DB=beatdash
BEATDASH_POSTGRES_PORT=5432

BEATDASH_ConnectionStrings__Default=Host=localhost;Port=5432;Database=beatdash;Username=admin;Password=admin
